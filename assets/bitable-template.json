{
  "version": "1.0",
  "description": "微信聊天记录 -> 飞书多维表格 的建表模板。field_name / type / property 与飞书 bitable v1 API 对齐。",
  "table": {
    "name_template": "微信记录_{YYYY-MM}",
    "default_view_name": "全部消息",
    "fields": [
      {
        "field_name": "发送时间",
        "type": 5,
        "property": {
          "date_formatter": "yyyy/MM/dd HH:mm",
          "auto_fill": false
        }
      },
      {
        "field_name": "日期",
        "type": 5,
        "property": {
          "date_formatter": "yyyy/MM/dd",
          "auto_fill": false
        }
      },
      {
        "field_name": "发送者",
        "type": 1
      },
      {
        "field_name": "消息类型",
        "type": 3,
        "property": {
          "options": [
            { "name": "text" },
            { "name": "image" },
            { "name": "voice" },
            { "name": "video" },
            { "name": "file" },
            { "name": "link" },
            { "name": "quote" },
            { "name": "emoji" },
            { "name": "system" },
            { "name": "other" }
          ]
        }
      },
      {
        "field_name": "内容",
        "type": 1
      },
      {
        "field_name": "引用内容",
        "type": 1
      },
      {
        "field_name": "附件",
        "type": 17
      },
      {
        "field_name": "附件链接",
        "type": 15
      },
      {
        "field_name": "是否本人",
        "type": 7
      },
      {
        "field_name": "消息ID",
        "type": 1
      },
      {
        "field_name": "原始类型",
        "type": 2
      }
    ]
  },
  "column_mapping": {
    "发送时间": { "source": "ts", "transform": "seconds_to_millis" },
    "日期": { "source": "ts", "transform": "seconds_to_millis" },
    "发送者": { "source": "sender_name" },
    "消息类型": { "source": "type" },
    "内容": { "source": "content" },
    "引用内容": { "source": "quote_content" },
    "附件": { "source": "media_path", "transform": "upload_media" },
    "附件链接": { "source": "media_path", "transform": "cloud_link" },
    "是否本人": { "source": "is_self", "transform": "to_bool" },
    "消息ID": { "source": "msg_id" },
    "原始类型": { "source": "raw_type", "transform": "to_int" }
  },
  "hidden_fields": ["消息ID", "原始类型"],
  "views": [
    {
      "name": "按天看",
      "type": "grid",
      "group_by": "日期",
      "sort": [{ "field": "发送时间", "order": "asc" }]
    },
    {
      "name": "只看文件",
      "type": "grid",
      "filter": {
        "conjunction": "or",
        "conditions": [
          { "field": "消息类型", "operator": "is", "value": ["image"] },
          { "field": "消息类型", "operator": "is", "value": ["file"] },
          { "field": "消息类型", "operator": "is", "value": ["video"] }
        ]
      }
    },
    {
      "name": "只看我自己",
      "type": "grid",
      "filter": {
        "conjunction": "and",
        "conditions": [
          { "field": "是否本人", "operator": "is", "value": ["true"] }
        ]
      }
    },
    {
      "name": "只看引用",
      "type": "grid",
      "filter": {
        "conjunction": "and",
        "conditions": [
          { "field": "消息类型", "operator": "is", "value": ["quote"] }
        ]
      }
    }
  ],
  "attachment_policy": {
    "inline_types": ["jpg", "jpeg", "png", "gif", "webp", "bmp"],
    "inline_max_bytes": 20971520,
    "cloud_types": ["mp4", "mov", "pdf", "docx", "xlsx", "pptx", "zip", "rar", "7z"],
    "skip_types": ["emoji", "thumbnail"],
    "parent_type_image": "bitable_image",
    "parent_type_file": "bitable_file"
  },
  "write_policy": {
    "batch_size": 200,
    "sleep_ms": 300,
    "max_retries": 5,
    "retryable_codes": [1254290, 1254291, 1255001, 99991400],
    "idempotency_key": "msg_id",
    "attachment_dedup_key": "media_md5"
  },
  "sharding": {
    "under_10000": "single_table",
    "10000_to_50000": "by_month",
    "over_50000": "by_month_and_chat",
    "timezone": "UTC+8"
  }
}
